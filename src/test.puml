@startuml
title Catalog Service - Internal Composition (CQRS + Vertical Slice)
skinparam componentStyle rectangle

package "Catalog.API (ASP.NET Core)" {

  package "API Layer" as Api {
    component "ProductsController" as C_ProductsController <<REST>>
    component "Swagger/OpenAPI" as C_Swagger <<Doc>>
    component "Auth/JWT Middleware" as C_Auth <<Middleware>>
  }

  package "Application (CQRS)" as App {

    package "Queries" as Q {
      component "GetProductsQuery" as Q_GetProductsQuery <<Query>>
      component "GetProductByIdQuery" as Q_GetProductByIdQuery <<Query>>
      component "SearchProductsQuery" as Q_SearchProductsQuery <<Query>>

      component "GetProductsHandler" as Q_GetProductsHandler <<Handler>>
      component "GetProductByIdHandler" as Q_GetProductByIdHandler <<Handler>>
      component "SearchProductsHandler" as Q_SearchProductsHandler <<Handler>>
    }

    package "Commands" as C {
      component "CreateProductCommand" as C_CreateProductCommand <<Command>>
      component "UpdateProductCommand" as C_UpdateProductCommand <<Command>>
      component "DeleteProductCommand" as C_DeleteProductCommand <<Command>>

      component "CreateProductHandler" as C_CreateProductHandler <<Handler>>
      component "UpdateProductHandler" as C_UpdateProductHandler <<Handler>>
      component "DeleteProductHandler" as C_DeleteProductHandler <<Handler>>
    }

    component "Validation Pipeline" as App_ValidationPipeline <<Behavior>>
    component "DTO Mapper" as App_DTOMapper <<Mapper>>
  }

  package "Domain" as Dom {
    component "Product" as D_Product <<Aggregate>>
    component "Money" as D_Money <<ValueObject>>
    component "Sku" as D_Sku <<ValueObject>>
    component "ProductPolicy" as D_ProductPolicy <<DomainService>>
  }

  package "Infrastructure" as Infra {
    component "ProductRepository" as I_ProductRepository <<Repository>>
    component "UnitOfWork" as I_UnitOfWork <<Tx>>
    component "EF Core DbContext" as I_DbContext <<ORM>>
    database "PostgreSQL\nCatalogDB" as DB_Pg
    component "Migrations" as I_Migrations <<Schema>>
    component "FileStorage (Images)" as I_FileStorage <<Adapter>>
  }
}

Q_GetProductsQuery ..> Q_GetProductsHandler : carried by
Q_GetProductByIdQuery ..> Q_GetProductByIdHandler : carried by
Q_SearchProductsQuery ..> Q_SearchProductsHandler : carried by
C_CreateProductCommand ..> C_CreateProductHandler : carried by
C_UpdateProductCommand ..> C_UpdateProductHandler : carried by
C_DeleteProductCommand ..> C_DeleteProductHandler : carried by

' --- Relations internes ---
C_ProductsController --> App
App --> Dom

Q_GetProductsHandler --> I_ProductRepository
Q_GetProductByIdHandler --> I_ProductRepository
Q_SearchProductsHandler --> I_ProductRepository

C_CreateProductHandler --> I_ProductRepository
C_UpdateProductHandler --> I_ProductRepository
C_DeleteProductHandler --> I_ProductRepository

I_ProductRepository --> I_DbContext
I_DbContext --> DB_Pg
I_Migrations ..> DB_Pg

App_ValidationPipeline ..> C
App_ValidationPipeline ..> Q
App_DTOMapper ..> D_Product

' --- Bord du contexte ---
component "API Gateway" as APIGW
APIGW --> C_ProductsController : HTTP/REST

@enduml
